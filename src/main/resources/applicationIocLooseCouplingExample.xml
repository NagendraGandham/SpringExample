<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="userDataprovider" class="loosecouplingIoc.UserDatabaseProvider">
    </bean>

    <bean id="userWebServiceDataprovider" class="loosecouplingIoc.UserWebServiceDataProvider">
    </bean>

    <bean id="userManagerWithuserDataprovider" class="loosecouplingIoc.UserManager">
        <constructor-arg ref="userDataprovider"/>
    </bean>

    <bean id="userManagerWithuserWebServiceDataprovider" class="loosecouplingIoc.UserManager">
        <constructor-arg ref="userWebServiceDataprovider"/>
    </bean>

</beans>
